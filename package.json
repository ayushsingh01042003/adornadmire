{
  "name": "adorn-admire-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "npx --yes serve@14 build/client --no-clipboard",
    "media": "node scripts/optimize-media.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@react-router/node": "^7.18.3",
    "isbot": "^5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.3",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3"
  }
}
