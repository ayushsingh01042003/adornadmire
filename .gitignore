# Build output
build
.react-router
.vercel

# public/img, public/media and the icons are generated by `npm run media` but
# ARE committed deliberately: regenerating them needs ffmpeg-static (~80 MB) and
# about 80 seconds, which is not worth paying for on every deploy when the
# source footage almost never changes. Re-run `npm run media` and commit the
# result after replacing anything in src/assets.

# Regenerated on every build by scripts/generate-seo-files.mjs
/public/sitemap.xml
/public/robots.txt

